{
  "name": "clipjar",
  "version": "1.0.6",
  "description": "跨平台剪贴板管理器",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:win": "npm run build && tauri build --target x86_64-pc-windows-msvc --bundles msi,nsis",
    "build:mac": "npm run build && tauri build --target aarch64-apple-darwin --bundles dmg",
    "build:mac:intel": "npm run build && tauri build --target x86_64-apple-darwin --bundles dmg",
    "build:linux": "npm run build && tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:browser": "node tests/browser-regressions.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:history": "cargo test --locked --manifest-path src-tauri/history-core/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "motion": "^14.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
